Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    // Проверяем заполненность контрагента
    Если Контрагент = Неопределено Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    // Проверяем остатки
    Для Каждого СтрокаТЧ Из Товары Цикл
        Если СтрокаТЧ.Количество <= 0 Тогда
            Отказ = Истина;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПолучитьСумму() Экспорт
    Сумма = 0;
    Для Каждого СтрокаТЧ Из Товары Цикл
        Сумма = Сумма + СтрокаТЧ.Сумма;
    КонецЦикла;
    Возврат Сумма;
КонецФункции
